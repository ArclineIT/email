# Aliases first, then the domain's catch-all for anything left over.
#   virtual_alias_maps = sqlite:/etc/postfix/sqlite-virtual-aliases.cf,
#                        sqlite:/etc/postfix/sqlite-virtual-catchall.cf
dbpath = /var/lib/arcline-email/production.sqlite3
query = SELECT aliases.destinations FROM aliases
        JOIN domains ON domains.id = aliases.domain_id
        WHERE aliases.address = '%s' AND aliases.active = 1 AND domains.active = 1
