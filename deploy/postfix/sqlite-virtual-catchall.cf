# Postfix asks for "@example.com" after the full address finds nothing. A real
# mailbox must win over the catch-all, so list sqlite-virtual-mailbox-identity.cf
# before this map.
dbpath = /var/lib/arcline-email/production.sqlite3
query = SELECT catch_all FROM domains WHERE '@' || name = '%s' AND active = 1 AND catch_all != ''
