# Copy to .env and fill in your values. Never commit the real .env.
# Loaded automatically in development and test via dotenv-rails.

# --- Server ---
# Puma reads PORT (default 3000).
PORT=3000
# SQLite database file path. Postfix and Dovecot read this same file.
DATABASE_PATH=/var/lib/arcline-email/production.sqlite3

# --- Mail server ---
# The mail server's hostname: what each domain's MX record should point at.
EMAIL_MAIL_HOST=mail.arcline.it

# --- Admin login (HTTP basic auth, required in production) ---
EMAIL_ADMIN_USERNAME=admin
EMAIL_ADMIN_PASSWORD=
